<div class="section-header" {{#if id}}id="{{id}}-header"{{/if}}>
    <span class="section-name" {{#if id}}id="{{id}}-name"{{/if}}>{{name}}</span>
    <span class="section-line" aria-hidden="true" {{#if id}}id="{{id}}-line"{{/if}}></span>
    {{#if buttons}}
        <div class="section-filter" role="toolbar" aria-label="{{buttonsDescription}}" {{#if id}}id="{{id}}-buttons"{{/if}}>
            {{#each buttons as |btn|}}
                <button type="button"
                        class="btn-filter"
                        data-action="{{#if btn.action}}{{btn.action}}{{else}}{{../buttonsAction}}{{/if}}"
                        data-filter="{{btn.name}}"
                        aria-pressed="{{btn.active}}">
                    <i class="bi {{btn.icon}}"></i> {{capitalize btn.name}}
                </button>
            {{/each}}
        </div>
    {{/if}}
</div>
<div class="section-body" {{#if id}}id="{{id}}-body"{{/if}}>
    {{~> @partial-block}}
</div>