<div class="section-header">
    <span class="section-name">{{name}}</span>
    <span class="section-line" aria-hidden="true"></span>
    {{#if buttons}}
        <div class="section-filter" role="toolbar" aria-label="{{buttonsDescription}}">
            {{#each buttons as |btn|}}
                <button type="button"
                        class="btn-filter"
                        data-action="{{#if btn.action}}{{btn.action}}{{else}}{{../buttonsAction}}{{/if}}"
                        data-filter="{{btn.name}}"
                        aria-pressed="{{btn.active}}">
                    <i class="bi {{btn.icon}}"></i> {{capitalize btn.name}}
                </button>
            {{/each}}
        </div>
    {{/if}}
</div>
<div class="section-body">
    {{~> @partial-block}}
</div>