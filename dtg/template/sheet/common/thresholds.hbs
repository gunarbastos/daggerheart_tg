<div class="dmg-threshold">
    <span class="field-label">Minor</span>
    <span class="field-label">Major</span>
    <span class="field-label">Severe</span>
    {{#> numberField }} class="field-input minor-major-threshold" name="{{majorThresholdField}}" value="{{majorThresholdValue}}" {{/numberField}}
    {{#> numberField }} class="field-input major-severe-threshold" name="{{severeThresholdField}}" value="{{severeThresholdValue}}" {{/numberField}}
</div>