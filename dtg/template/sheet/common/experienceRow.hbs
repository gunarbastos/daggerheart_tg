<div class="experience experience-row" id="{{experience.id}}" data-order="{{index}}">
    <label class="switch" data-tooltip="When active, rolls will consume hope to give you the listed bonus">
        <input type="checkbox" class="switch-input" name="system.experiences.{{index}}.enabled" value="{{experience.enabled}}" tabindex="-1">
        <span class="switch-track" aria-hidden="true"></span>
    </label>
    <input type="hidden" name="system.experiences.{{index}}.id" value="{{experience.id}}" />
    {{#> numberField }} class="field-input small-input" name="system.experiences.{{index}}.bonus" value="{{experience.bonus}}" {{/numberField}}
    {{#> textField }} class="field-input" name="system.experiences.{{index}}.description" value="{{experience.description}}" {{/textField}}
    {{#> btnDelete action="deleteExperience" skipTab=true }}{{/btnDelete}}
</div>