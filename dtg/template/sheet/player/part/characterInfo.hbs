<section class="dtg-part part-character-info" data-part-id="characterInfo">

    <div class="ci-left">
        <div class="ci-image">
            <img class="profile-img"
                 src="{{source.img}}"
                 alt="{{source.name}}"
                 data-action="editImage"
                 data-edit="img" />
        </div>

        <div class="ci-level">
            <label class="field-label" for="pc-level">Level</label>
            {{#> numberField }} id="pc-level" class="field-input" name="system.level" value="{{system.level}}" placeholder="0" {{/numberField}}
        </div>
    </div>

    <div class="ci-main">
        <div class="ci-column">
            <div class="ci-field">
                <label class="field-label" for="pc-name">Name</label>
                {{#> textField }} id="pc-name" class="field-input"  name="name" value="{{source.name}}" placeholder="Unnamed Hero" {{/textField}}
            </div>

            <div class="ci-field">
                <label class="field-label">Class</label>
                {{#> textField }} id="pc-name" class="field-input"  value="{{classText}}" disabled {{/textField}}
            </div>
        </div>

        <div class="ci-column">
            <div class="ci-field">
                <label class="field-label">Ancestry</label>
                {{#> textField }} id="pc-name" class="field-input" value="{{ancestry}}" disabled {{/textField}}
            </div>

            <div class="ci-field">
                <label class="field-label">Origin</label>
                {{#> textField }} id="pc-name" class="field-input" value="{{origin}}" disabled {{/textField}}
            </div>
        </div>
    </div>

    <div class="ci-side">
        <div class="ci-side-top">
            {{> btnSettings }}
        </div>

        <div class="ci-flags" aria-label="Flags">
            <button type="button"
                    class="btn-action{{#if flagRollModAdv}} shine{{/if}}"
                    title="Advantage"
                    data-action="setFlag"
                    data-name="rollMod"
                    data-value="{{CONSTANTS.ROLL_MODIFICATIONS.ADVANTAGE}}"
                    data-toggle="true">
                <img src="{{CONSTANTS.ASSETS.ICON_DIR}}/{{CONSTANTS.ASSETS.ICONS.ADVANTAGE}}"
                     width="24" height="24"
                     alt="Advantage" />
            </button>

            <button type="button"
                    class="btn-action{{#if flagRollModDis}} shine{{/if}}"
                    title="Disadvantage"
                    data-action="setFlag"
                    data-name="rollMod"
                    data-value="{{CONSTANTS.ROLL_MODIFICATIONS.DISADVANTAGE}}"
                    data-toggle="true">
                <img src="{{CONSTANTS.ASSETS.ICON_DIR}}/{{CONSTANTS.ASSETS.ICONS.DISADVANTAGE}}"
                     width="24" height="24"
                     alt="Disadvantage" />
            </button>
        </div>
    </div>

    {{!-- Bottom center: proficiency --}}
    <div class="ci-proficiency">
        <label class="field-label" for="pc-proficiency">Proficiency</label>
        {{#> numberField }} id="pc-proficiency" class="field-input" name="system.proficiency" value="{{system.proficiency}}" placeholder="0" {{/numberField}}
    </div>

</section>