<div class="settings-list">
    <span class="title">Max HP:</span> {{#> numberField }} class="res-input max" name="system.resources.hp.max" value="{{system.resources.hp.max}}" {{/numberField}}</span>
    <span class="title">Max Armor:</span> {{#> numberField }} class="res-input max" name="system.resources.armor.max" value="{{system.resources.armor.max}}" {{/numberField}}</span>
    <span class="title">Max Stress:</span> {{#> numberField }} class="res-input max" name="system.resources.stress.max" value="{{system.resources.stress.max}}" {{/numberField}}</span>
    <span class="title">Max Hope:</span> {{#> numberField }} class="res-input max" name="system.resources.hope.max" value="{{system.resources.hope.max}}" {{/numberField}}</span>
    <span class="title">Scars:</span> {{#> numberField }} class="res-input scars" name="system.scars" value="{{system.scars}}" {{/numberField}}</span>
</div>





