<div class="settings-list">
    <span class="field-label">Max HP:</span> {{#> numberField }} class="field-input max" name="system.resources.hp.max" value="{{system.resources.hp.max}}" {{/numberField}}
    <span class="field-label">Max Armor:</span> {{#> numberField }} class="field-input max" name="system.resources.armor.max" value="{{system.resources.armor.max}}" {{/numberField}}
    <span class="field-label">Max Stress:</span> {{#> numberField }} class="field-input max" name="system.resources.stress.max" value="{{system.resources.stress.max}}" {{/numberField}}
    <span class="field-label">Max Hope:</span> {{#> numberField }} class="field-input max" name="system.resources.hope.max" value="{{system.resources.hope.max}}" {{/numberField}}
    <span class="field-label">Scars:</span> {{#> numberField }} class="field-input scars" name="system.scars" value="{{system.scars}}" {{/numberField}}
</div>