
<section class="dtg-part part-traits" data-part-id="traits" aria-label="Traits">

    <div class="traits-wrap">
        <div class="traits-grid">
            {{> playerSheetTrait trait="strength" value=system.traits.strength }}
            {{> playerSheetTrait trait="agility" value=system.traits.agility }}
            {{> playerSheetTrait trait="finesse" value=system.traits.finesse }}
            {{> playerSheetTrait trait="knowledge" value=system.traits.knowledge }}
            {{> playerSheetTrait trait="instinct" value=system.traits.instinct }}
            {{> playerSheetTrait trait="presence" value=system.traits.presence }}
        </div>
    </div>
</section>
