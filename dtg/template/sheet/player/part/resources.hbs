<section class="dtg-part part-resources" data-part-id="resources" aria-label="Resources">
    <div class="resources-list">
        {{> sheetResourceRow resource=resources.hp }}
        {{> sheetResourceRow resource=resources.armor }}
        {{> sheetResourceRow resource=resources.stress }}

        <div class="eva-thresholds">
            <div class="evasion">
                <span class="field-label">Evasion</span>
                {{#> numberField }} class="field-input evasion" name="system.evasion" value="{{system.evasion}}" {{/numberField}}
            </div>
            {{> sheetThresholds majorThresholdField="system.majorDamageThreshold" majorThresholdValue=system.majorDamageThreshold severeThresholdField="system.severeDamageThreshold" severeThresholdValue=system.severeDamageThreshold }}
        </div>

        {{> sheetResourceRow resource=resources.hope }}
    </div>
</section>


