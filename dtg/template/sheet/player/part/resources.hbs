<section class="dtg-part part-resources" data-part-id="resources" aria-label="Resources">
    <div class="resources-list">
        {{> sheetResourceRow resource=resources.hp }}
        {{> sheetResourceRow resource=resources.armor }}
        {{> sheetResourceRow resource=resources.stress }}

        <div class="eva-thresholds">
            <div class="evasion">
                <span class="field-label">Evasion</span>
                {{#> numberField }} class="field-input evasion" name="system.evasion" value="{{system.evasion}}" {{/numberField}}
            </div>
            <div class="dmg-threshold">
                <span class="field-label">Minor</span>
                <span class="field-label">Major</span>
                <span class="field-label">Severe</span>
                {{#> numberField }} class="field-input minor-major-threshold" name="system.majorDamageThreshold" value="{{system.majorDamageThreshold}}" {{/numberField}}
                {{#> numberField }} class="field-input major-severe-threshold" name="system.severeDamageThreshold" value="{{system.severeDamageThreshold}}" {{/numberField}}
            </div>
        </div>

        {{> sheetResourceRow resource=resources.hope }}
    </div>
</section>


