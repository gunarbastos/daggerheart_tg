<section class="dtg-part part-resources" data-part-id="resources" aria-label="Resources">
    <div class="resources-list">
        {{> playerSheetResourceRow resource=resources.hp }}
        {{> playerSheetResourceRow resource=resources.armor }}
        {{> playerSheetResourceRow resource=resources.stress }}

        <div class="res-line res-line-block threshold">
            <div class="res-label">Damage Thresholds</div>
            <div class="res-thresholds">
                <span class="th-label">Minor</span>
                {{#> numberField }} class="res-input th-input" name="system.majorDamageThreshold" value="{{system.majorDamageThreshold}}" {{/numberField}}
                <span class="th-label">Major</span>
                {{#> numberField }} class="res-input th-input" name="system.severeDamageThreshold" value="{{system.severeDamageThreshold}}" {{/numberField}}
                <span class="th-label">Severe</span>
            </div>
        </div>
        <div class="res-line res-line-block evasion">
            <span class="th-label">Evasion</span>
            {{#> numberField }} class="res-input evasion" name="system.evasion" value="{{system.evasion}}" {{/numberField}}
        </div>

        {{> playerSheetResourceRow resource=resources.hope }}
    </div>
</section>


