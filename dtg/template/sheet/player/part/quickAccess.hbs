<section class="dtg-part part-quick-access" data-part-id="quick-access" data-drop-scope="quick-access" aria-label="quick-access">
    <div class="panel-body">
        <div class="info-section">
            {{#> sheetSection name="Experiences" buttons=experienceButtons id="experiences"}}
                <div class="info">
                </div>
            {{/sheetSection}}
        </div>

        <div class="actions-section">
            {{#> sheetSection name="Actions" buttonsDescription="Filter Action types" buttonsAction="filterActions" buttons=actionFilters id="actions"}}
                <div class="actions">
                </div>
            {{/sheetSection}}
        </div>
    </div>
</section>