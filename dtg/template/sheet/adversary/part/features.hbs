<section class="dtg-part part-features" data-part-id="features">
    {{#> sheetSection name="Features" buttons=featureBtns}}
        {{#if gridMode}}
            <ul class="item-list" data-list="features">
                {{#each features as |feature|}}
                    <li class="item-row" data-item-id="{{feature.id}}">
                        <div class="item-main">
                            <span class="item-name" data-action="openItem">{{feature.system.name}}</span>
                        </div>

                        <div class="item-actions">
                            <button type="button"
                                    class="btn-action bi bi-arrow-up-right-square"
                                    data-action="openItem" title="Open"></button>
                            <button type="button"
                                    class="btn-action bi bi-chat-right-quote-fill"
                                    data-action="openItem" title="PostToChat"></button>
                            {{#if feature.activatable}}
                                <button type="button"
                                        class="btn-action bi bi-lightning-fill"
                                        data-action="activateItem"
                                        title="Activate"></button>
                            {{/if}}
                            {{#if feature.hasHit}}
                                <button type="button"
                                        class="btn-action bi bi-crosshair"
                                        data-action="activateItem"
                                        title="Activate"></button>
                            {{/if}}
                            {{#if feature.hasDamage}}
                                <button type="button"
                                        class="btn-action bi bi-fire"
                                        data-action="activateItem"
                                        title="Activate"></button>
                            {{/if}}
                            <button type="button"
                                    class="btn-action danger bi bi-trash-fill"
                                    data-action="deleteItem"
                                    title="Remove"></button>
                        </div>
                    </li>
                {{/each}}
            </ul>
        {{/if}}
        {{#if cardMode}}
            <div class="card-container">
                <div class="actions">
                    {{#each features as |feature|}}
                        <div class="{{#if features.isAttack}}attack {{else}}{{#if features.isBorrowedPower}}borrowed-power {{else}}other-action {{/if}}{{/if}}action">
                            <span class="action-name">{{features.name}}</span>
                            {{#if a.isAttack}}
                                <button type="button" class="roll-btn" data-action="featureRollHit"><i class="bi bi-crosshair"></i></button>
                                <button type="button" class="roll-btn" data-action="featureRollDamage"><i class="bi bi-fire"></i></button>
                            {{else}}
                                <button type="button" class="roll-btn" data-action="featureActivate"><i class="bi {{#if a.isBorrowedPower}}bi-hurricane{{else}}bi-crosshair{{/if}}"></i></button>
                            {{/if}}
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    {{/sheetSection}}
</section>