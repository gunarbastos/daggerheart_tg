<section class="dtg-part part-adversary-info" data-part-id="adversaryInfo">

    <div class="column-left">
        <div class="ci-image">
            <img class="profile-img"
                 src="{{source.img}}"
                 alt="{{source.name}}"
                 data-action="editImage"
                 data-edit="img" />
        </div>

    </div>

    <div class="column-main">
        <div class="row">
            <div class="field">
                <label class="field-label" for="actor-name">Name</label>
                {{#> textField }} id="actor-name" class="field-input"  name="name" value="{{source.name}}" placeholder="Unnamed Hero" {{/textField}}
            </div>
        </div>
        <div class="row multi-field">
            <div class="field">
                <label class="field-label" for="actor-name">Type</label>
                {{#> textField }} id="actor-name" class="field-input"  name="system.type" value="{{system.type}}" {{/textField}}
            </div>
            <div class="field">
                <label class="field-label" for="actor-name">Tier</label>
                {{#> numberField }} id="actor-name" class="field-input"  name="system.tier" value="{{system.tier}}" {{/numberField}}
            </div>
        </div>
    </div>

    <div class="buttons-pane">
        <div class="buttons-pane-top">
            <button type="button" class="btn-settings" data-action="openSettings" title="Settings">
                <i class="bi bi-gear-fill" aria-hidden="true"></i>
                <span class="visually-hidden">Settings</span>
            </button>
        </div>

        <div class="buttons-pane-bottom" aria-label="Flags">
            <button type="button"
                    class="btn-action{{#if flagRollModAdv}} shine{{/if}}"
                    title="Advantage"
                    data-action="setFlag"
                    data-name="rollMod"
                    data-value="{{CONSTANTS.ROLL_MODIFICATIONS.ADVANTAGE}}"
                    data-toggle="true">
                <img src="{{CONSTANTS.ASSETS.ICON_DIR}}/{{CONSTANTS.ASSETS.ICONS.ADVANTAGE}}"
                     width="24" height="24"
                     alt="Advantage" />
            </button>

            <button type="button"
                    class="btn-action{{#if flagRollModDis}} shine{{/if}}"
                    title="Disadvantage"
                    data-action="setFlag"
                    data-name="rollMod"
                    data-value="{{CONSTANTS.ROLL_MODIFICATIONS.DISADVANTAGE}}"
                    data-toggle="true">
                <img src="{{CONSTANTS.ASSETS.ICON_DIR}}/{{CONSTANTS.ASSETS.ICONS.DISADVANTAGE}}"
                     width="24" height="24"
                     alt="Disadvantage" />
            </button>
        </div>
    </div>

</section>
